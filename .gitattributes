# Track large notebooks and data artifacts with Git LFS
notebooks/*.ipynb filter=lfs diff=lfs merge=lfs -text
# Optionally track large raster and HTML outputs if ever versioned
# data/**/*.tif filter=lfs diff=lfs merge=lfs -text
# notebooks/**/*.html filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.nc filter=lfs diff=lfs merge=lfs -text
*.hdf filter=lfs diff=lfs merge=lfs -text
